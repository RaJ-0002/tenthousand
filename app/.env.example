SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional, only needed for the Google OAuth "Continue with Google" button.
GOOGLE_WEB_CLIENT_ID=your-google-oauth-web-client-id
# Where this app is actually reachable in the browser. Used as the OAuth
# redirect target -- must be added under Supabase Dashboard > Authentication
# > URL Configuration > Redirect URLs, or Google/Supabase will silently
# fall back to the project's default Site URL instead. Keep this port fixed
# in local dev (always run `flet run main.py --web --port 8550`) so you only
# have to register it once.
APP_BASE_URL=http://127.0.0.1:8550
